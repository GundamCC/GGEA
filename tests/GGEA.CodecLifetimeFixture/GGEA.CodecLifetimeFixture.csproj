         加载到可回收上下文时不会覆盖 WPF 对 GGEA 资源程序集的解析。 -->
    <Compile Include="..\..\src\GGEA.App\Vision\ImageCodecThread.cs" Link="ImageCodecThread.cs" />
  </ItemGroup>
</Project>
