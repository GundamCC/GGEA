<Window x:Class="GGEA.ReleaseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GGEA 发布管理器" Width="1080" Height="720" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#0D1420" Foreground="#E9F0F4"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#172330" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2C3B49" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A9BAC7" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#284457" />
            <Setter Property="Foreground" Value="#F4FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="17,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.83" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#28A6A0" />
            <Setter Property="Foreground" Value="#071A21" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101B27" />
            <Setter Property="Foreground" Value="#E9F0F4" />
            <Setter Property="BorderBrush" Value="#3B5363" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="CaretBrush" Value="#E9F0F4" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GGEA  /  RELEASE DESK" Foreground="#63C7C1" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="发布管理器" FontSize="29" FontWeight="SemiBold" Margin="0,4,0,2" />
                <TextBlock Text="构建普通版与开发版，生成本地程序和完整压缩包。" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <Button x:Name="SettingsButton" Content="配置目录" Click="SettingsButton_Click" Margin="0,0,8,0" />
                <Button x:Name="RefreshButton" Content="刷新状态" Click="RefreshButton_Click" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Content="取消当前操作" Click="CancelButton_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="源码仓库" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <TextBox x:Name="SourcePathBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True" />
                <Button Grid.Row="0" Grid.Column="2" Content="选择文件夹" Click="BrowseSourceButton_Click" Margin="9,0,0,0" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="版本" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="0,0,30,0" />
                    <TextBlock Text="源码提交" Foreground="{StaticResource MutedBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="CommitText" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,0,30,0" />
                    <TextBlock x:Name="WorkingTreeText" Foreground="#E8C276" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 说明共享行高，文本换行时两侧建立按钮仍保持对齐。 -->
        <Grid Grid.Row="2" Margin="0,0,0,14" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" SharedSizeGroup="BuildDescription" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="01  普通版本" Foreground="#63C7C1" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="从当前工作区快速生成独立 Release 程序或 ZIP，供本地验证；正式发布请使用完整构建。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,15" />
                    <WrapPanel Grid.Row="2">
                        <StackPanel Margin="0,0,8,8">
                            <Button x:Name="PublishNormalButton" Content="建立普通版本" Click="PublishNormalButton_Click" />
                            <Button x:Name="OpenNormalButton" Content="打开普通版本" Click="OpenNormalButton_Click" Margin="0,8,0,0" ToolTip="启动 artifacts/publish/GGEA.exe" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <Button x:Name="PackageNormalButton" Content="打包普通版本" Click="PackageNormalButton_Click" />
                            <Button x:Name="OpenPackageButton" Content="打开文件路径" Click="OpenPackageButton_Click" Margin="0,8,0,0" ToolTip="打开 artifacts/dist 文件夹" />
                        </StackPanel>
                        <Button x:Name="BuildButton" Content="完整构建并打包" Click="BuildButton_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" VerticalAlignment="Top" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" SharedSizeGroup="BuildDescription" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="02  开发版本" Foreground="#63C7C1" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="Debug 构建、测试并生成独立目录；包含当前工作区修改。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,15" />
                    <WrapPanel Grid.Row="2">
                        <StackPanel Margin="0,0,8,8">
                            <Button x:Name="BuildDevButton" Content="建立开发版本" Click="BuildDevButton_Click" />
                            <Button x:Name="OpenDevButton" Content="打开开发版本" Click="OpenDevButton_Click" Margin="0,8,0,0" ToolTip="启动 dev/GGEA.exe" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <Button x:Name="PackageDevButton" Content="打包开发版本" Click="PackageDevButton_Click" />
                            <Button x:Name="OpenDevPackageButton" Content="打开文件路径" Click="OpenDevPackageButton_Click" Margin="0,8,0,0" ToolTip="打开 artifacts/dev-dist 文件夹" />
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="18,14,18,12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="执行记录" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="StateText" Grid.Column="1" Foreground="#63C7C1" Text="就绪" />
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="1" Margin="18,0,18,0" FontFamily="Consolas" FontSize="12"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" Background="#0C1722" BorderThickness="0" />
                <TextBlock Grid.Row="2" Text="所有操作均在本机执行；完整构建使用固定提交，失败时请先检查执行记录。"
                           Foreground="{StaticResource MutedBrush}" Margin="18,11,18,13" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
