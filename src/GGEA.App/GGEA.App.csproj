<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GGEA.App</RootNamespace>
    <AssemblyName>GGEA</AssemblyName>
    <!-- 程序图标：GGEA.exe 与窗口/任务栏共用该图标 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 统一程序集、文件与产品版本号 -->
    <Version>1.3.6.0</Version>
    <!-- Windows 产品版本保持为纯语义版本，不追加 Git 提交哈希 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>GGEA</Product>
    <!-- 单文件发布时压缩托管程序集，可显著缩小 EXE 体积（仅对 PublishSingleFile 生效） -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\ja.json" LogicalName="GGEA.App.Localization.ja.json" />
    <!-- 更新逻辑与独立进程共用程序集，避免主程序和安装器使用两套文件安全规则。 -->
    <ProjectReference Include="..\GGEA.Updater\GGEA.Updater.csproj" />
    <ProjectReference Include="..\GGEA.Plugin.Abstractions\GGEA.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <!-- 所有发布入口统一携带自包含更新器，用户机器无需 SDK/PowerShell。 -->
  <Target Name="PublishOnlineUpdater" AfterTargets="Publish">
    <PropertyGroup>
      <UpdaterPublishDirectory>$(MSBuildProjectDirectory)/obj/updater-publish/$(Configuration)</UpdaterPublishDirectory>
    </PropertyGroup>
    <!-- 只裁剪独立更新进程；主程序引用的共享程序集保持完整，WPF 不参与裁剪。 -->
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\GGEA.Updater\GGEA.Updater.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true -p:ILLinkTreatWarningsAsErrors=true -o &quot;$(UpdaterPublishDirectory)&quot;" />
    <Copy SourceFiles="$(UpdaterPublishDirectory)/GGEA.Updater.exe" DestinationFolder="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <!-- 发布脚本注入固定提交；解压自检将托管程序集身份与 build-info 交叉核验。 -->
    <AssemblyMetadata Include="GgeaReleaseCommit" Value="$(GgeaReleaseCommit)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 将默认配置与模板目录复制到输出目录，方便开发与发布后直接使用 -->
    <None Include="..\..\config\ggea.config.json" Link="config\ggea.config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\config\ap_consumption_profiles.json" Link="config\ap_consumption_profiles.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 初始备用源为空；用户导入配置受更新器 config/ 保留规则保护。 -->
    <None Include="..\..\config\update-sources.json" Link="config\update-sources.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 通用及六种语言资源保持同路径分发；OCR 也必须作为外部文件保留。 -->
    <None Include="..\..\resources\**\*" Link="resources\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- 法律声明保持外置；范围说明使用 txt 名称，避免发布清理 Markdown 时丢失。 -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\NOTICE.txt" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\LICENSE_SCOPE.md" Link="LICENSE_SCOPE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- 独立运行库安装入口必须外置，所有构建和发布渠道统一携带。 -->
    <None Include="..\..\tools\DependencySetup_依赖库安装.bat" Link="DependencySetup_依赖库安装.bat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- 发布包根目录提供最终用户文档，避免用户只能翻阅源码 README。 -->
    <None Include="..\..\使用说明.txt" Link="使用说明.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <!-- 仅使用 CPU 包；不要求用户安装 Python、CUDA 或单独的推理服务。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>

</Project>
