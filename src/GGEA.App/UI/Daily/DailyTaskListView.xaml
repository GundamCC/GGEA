<Grid x:Class="GGEA.App.UI.DailyTaskListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:loc="clr-namespace:GGEA.App.Localization"
      xmlns:ui="clr-namespace:GGEA.App.UI">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Text="{loc:Text Source='每日任务'}"
                   Style="{StaticResource CardTitle}"
                   VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
                   Text="{loc:Text Source='全选'}"
                   Style="{StaticResource InlineLabel}"
                   Margin="0,0,7,0"/>
        <CheckBox Grid.Column="2"
                  x:Name="DailySelectAllCheckBox"
                  Style="{StaticResource TaskCheckBox}"
                  ToolTip="{loc:Text Source='点击全选所有任务，再次点击取消全选'}"
                  Margin="0,0,9,0"
                  VerticalAlignment="Center"/>
    </Grid>

    <TextBlock Grid.Row="1" Text="{loc:Text Source='拖拽排序 · 按顺序执行已勾选任务'}"
               Style="{StaticResource HintText}"
               Margin="0,8,0,0"/>

    <ListBox Grid.Row="2" x:Name="DailyTaskList"
             Style="{StaticResource ApPlanList}"
             AllowDrop="True"
             Background="Transparent"
             BorderThickness="0"
             Margin="0,8,0,0"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemStateBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="2,0,0,0"
                                    CornerRadius="6">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Background="{DynamicResource Brush.CardAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="6"
                        Padding="8,8,8,9"
                        ToolTip="{Binding Description}"
                        MouseLeftButtonUp="OnTaskRowClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⠿"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   FontSize="15"
                                   Cursor="SizeAll"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding DisplayName}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   MouseLeftButtonUp="OnSettingsRequested">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanOpenSettings}" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Grid.Column="2" Width="22" Height="22" MinHeight="22" Padding="0"
                                Margin="9,0,5,0" VerticalAlignment="Center"
                                ToolTip="{loc:Text Source='打开对应设置页'}"
                                AutomationProperties.Name="{loc:Text Source='打开对应设置页'}"
                                Click="OnSettingsRequested">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSettings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource SettingsIconGeometry}" Fill="{DynamicResource Brush.Text}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- 与设置图标保持同一视觉层级；透明点击区保留键盘操作和删除语义。 -->
                        <Button Grid.Column="2" Margin="9,0,5,0" Width="22" Height="20"
                                VerticalAlignment="Center" Cursor="Hand"
                                AutomationProperties.Name="{loc:Text Source='删除强敌来袭任务'}"
                                ToolTip="{loc:Text Source='删除此强敌来袭任务'}" Click="OnRemoveRequested">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <Path Width="14" Height="16" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M 2,4 L 14,4 M 5,4 L 5,1 L 11,1 L 11,4 M 3,4 L 4,15 L 12,15 L 13,4 M 6,7 L 6,12 M 10,7 L 10,12"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanRemove}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <Trigger Property="ui:HoverFeedback.IsActive" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <CheckBox Grid.Column="3"
                                  Style="{StaticResource TaskCheckBox}"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsEnabled="{Binding IsSupported}"
                                  Margin="0,0,4,0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <Button Grid.Row="3" x:Name="DailyStartButton"
            Content="{loc:Text Source='任务开始'}"
            Margin="0,12,0,0"
            Style="{StaticResource ButtonPrimary}" ToolTip="{loc:Text Source='执行已勾选的每日任务'}"/>
</Grid>
