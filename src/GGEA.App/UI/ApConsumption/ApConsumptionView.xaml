<Grid x:Class="GGEA.App.UI.ApConsumptionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GGEA.App.Localization"
        xmlns:ui="clr-namespace:GGEA.App.UI"
        Margin="0,14,0,0">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="{loc:Text Source='拖拽作品调整执行顺序；至少勾选一个 Hard 关卡后，该作品才会加入 AP 消耗任务。'}"
               Style="{StaticResource HintText}"
               Margin="0,0,0,10"/>

    <!-- 配置工具栏使用标签在上的卡片布局，窄窗口下也能保持一致的控件边距。 -->
    <Border Grid.Row="1"
            Margin="0,0,0,12"
            Padding="12,10"
            Background="{DynamicResource Brush.Toolbar}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="130"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:Text Source='已保存方案'}"
                           Foreground="{DynamicResource Brush.TextDim}"
                           FontSize="11"
                           Margin="2,0,0,6"/>
                <ComboBox x:Name="ApProfileCombo"
                          Height="34"
                          Padding="12,6"
                          Margin="2,0,2,0"
                          Style="{StaticResource ComboBoxDark}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{DynamicResource Brush.Text}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Margin" Value="6,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="4,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Width="24"
                                                        Height="24"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{loc:Text Source='删除方案'}"
                                                        Tag="{Binding}"
                                                        Click="OnDeleteProfileRequested">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="DeleteBorder"
                                                                    Background="Transparent"
                                                                    CornerRadius="6"
                                                                    Padding="2">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="ui:HoverFeedback.IsActive" Value="True">
                                                                    <Setter TargetName="DeleteBorder"
                                                                            Property="Background"
                                                                            Value="{DynamicResource Brush.DangerSoft}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <Path Width="14" Height="16" Stretch="Uniform"
                                                          Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.4"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Data="M2,4 H14 M5.5,4 V2 H10.5 V4 M3.5,6 L4.2,15 H11.8 L12.5,6 M6.5,7.5 V12.5 M9.5,7.5 V12.5"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsHighlighted" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="False"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                            </MultiTrigger>
                                            <Trigger Property="ui:HoverFeedback.IsActive" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.Selection}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="{loc:Text Source='方案名称'}"
                           Foreground="{DynamicResource Brush.TextDim}"
                           FontSize="11"
                           Margin="2,0,0,6"/>
                <TextBox x:Name="ApProfileNameBox"
                         Height="34"
                         Style="{StaticResource TextBoxDark}"/>
            </StackPanel>

            <Button x:Name="SaveApProfileButton"
                    Grid.Column="4"
                    MinWidth="124"
                    Height="34"
                    VerticalAlignment="Bottom"
                    Content="{loc:Text Source='保存方案'}"
                    Style="{StaticResource ButtonPrimary}"/>
        </Grid>
    </Border>

    <!-- 表头补偿列表的 3px 内层边距及右侧 17px 系统滚动槽，短列表也保留滚动槽以稳定列位置。 -->
    <Border Grid.Row="2" Margin="8,0,25,6"
            Background="{DynamicResource Brush.CardAlt}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="58"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{loc:Text Source='作品'}" Style="{StaticResource InlineLabel}"/>
            <TextBlock Grid.Column="2" Text="Hard1" Style="{StaticResource InlineLabel}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Hard2" Style="{StaticResource InlineLabel}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Hard3" Style="{StaticResource InlineLabel}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="Hard4" Style="{StaticResource InlineLabel}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="Hard5" Style="{StaticResource InlineLabel}" HorizontalAlignment="Center"/>
        </Grid>
    </Border>

    <ListBox x:Name="ApWorkList"
             ItemContainerStyle="{StaticResource SelectableTaskRow}"
             Grid.Row="3"
             Style="{StaticResource ApPlanList}"
             AllowDrop="True"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Visible"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Background="{DynamicResource Brush.CardAlt}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="⋮⋮"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   FontSize="15"
                                   Cursor="SizeAll"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Work}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="2" Style="{StaticResource TaskCheckBox}"
                                  IsEnabled="{Binding IsHard1Enabled}"
                                  IsChecked="{Binding Hard1, Mode=TwoWay}"
                                  HorizontalAlignment="Center"/>
                        <CheckBox Grid.Column="3" Style="{StaticResource TaskCheckBox}"
                                  IsEnabled="{Binding IsHard2Enabled}"
                                  IsChecked="{Binding Hard2, Mode=TwoWay}"
                                  HorizontalAlignment="Center"/>
                        <CheckBox Grid.Column="4" Style="{StaticResource TaskCheckBox}"
                                  IsEnabled="{Binding IsHard3Enabled}"
                                  IsChecked="{Binding Hard3, Mode=TwoWay}"
                                  HorizontalAlignment="Center"/>
                        <CheckBox Grid.Column="5" Style="{StaticResource TaskCheckBox}"
                                  IsEnabled="{Binding IsHard4Enabled}"
                                  IsChecked="{Binding Hard4, Mode=TwoWay}"
                                  HorizontalAlignment="Center"/>
                        <CheckBox Grid.Column="6" Style="{StaticResource TaskCheckBox}"
                                  IsEnabled="{Binding IsHard5Enabled}"
                                  IsChecked="{Binding Hard5, Mode=TwoWay}"
                                  HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock x:Name="ApPlanStatusText"
               Grid.Row="4"
               Style="{StaticResource StatusText}"
               Text="{loc:Text Source='在左侧每日任务中勾选“消耗AP”，然后点击开始。当前阶段仅测试作品间跳转。'}"/>
</Grid>
