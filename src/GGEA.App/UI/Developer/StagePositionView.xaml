<Grid x:Class="GGEA.App.UI.StagePositionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GGEA.App.Localization"
        Margin="0,12,0,0">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{loc:Text Source='作品位置（画布坐标）'}" Style="{StaticResource CardTitle}"/>
    <TextBlock Grid.Row="1"
               Text="{loc:Text Source='直接修改作品在主要关卡画布上的绝对坐标并保存；保存后立即对 AP 消耗的作品跳转生效。'}"
               Style="{StaticResource HintText}"
               Margin="0,4,0,10"/>

    <ListBox x:Name="StagePositionList"
             Grid.Row="2"
             Style="{StaticResource ApPlanList}"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Background="{DynamicResource Brush.Toolbar}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,7"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Id}"
                                   Foreground="{DynamicResource Brush.TextDim}"
                                   VerticalAlignment="Center"
                                   FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding Work}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="4,0,8,0"/>
                        <TextBox Grid.Column="2" Text="{Binding CanvasX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxDark}"
                                 Height="30"
                                 Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBox Grid.Column="3" Text="{Binding CanvasY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource TextBoxDark}"
                                 Height="30"
                                 Padding="6,3"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,6,0"/>
                        <TextBlock Grid.Column="4" Text="✓"
                                   Foreground="{DynamicResource Brush.Success}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   ToolTip="{loc:Text Source='已实机验证'}"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="StagePositionRefreshButton" Content="{loc:Text Source='重新加载'}"
                Style="{StaticResource ButtonSecondary}"/>
        <Button x:Name="StagePositionSaveButton" Content="{loc:Text Source='保存'}"
                Margin="8,0,0,0"
                Style="{StaticResource ButtonPrimary}"/>
        <TextBlock x:Name="StagePositionStatusText"
                   Style="{StaticResource StatusText}"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"/>
    </StackPanel>
</Grid>
