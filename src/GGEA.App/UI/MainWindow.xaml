<Window x:Class="GGEA.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:GGEA.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GGEA — SD Gundam G Generation ETERNAL Assistant"
        Width="1280" Height="820"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{loc:UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- WPF 仅在键盘导航时显示 FocusVisualStyle，避免鼠标点击后留下焦点框。 -->
        <Style x:Key="HeaderKeyboardFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="3" Stroke="{DynamicResource Brush.Focus}" StrokeThickness="1"
                                   StrokeDashArray="1,2" RadiusX="4" RadiusY="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 顶部入口独立管理悬停反馈，不继承通用按钮的即时悬停与持久焦点边框。 -->
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource HeaderKeyboardFocus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="6"/>
                            <!-- 仅改变图标透明度，命中区域保持透明，避免悬停或点击出现底色。 -->
                            <ContentPresenter x:Name="IconContent" Opacity="0.65" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard Name="HoverDelay">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="IconContent" Storyboard.TargetProperty="Opacity">
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.65"/>
                                            <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <RemoveStoryboard BeginStoryboardName="HoverDelay"/>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Unloaded">
                                <RemoveStoryboard BeginStoryboardName="HoverDelay"/>
                            </EventTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,10,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 档案终端页眉：品牌、用途与细线构成层级，装饰不参与命中测试。 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GGEA" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" LineHeight="36"/>
                    <TextBlock Text="SD Gundam G Generation ETERNAL Assistant" FontSize="11" FontWeight="SemiBold" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 灯泡显示当前明暗状态；操作说明保留在提示与辅助功能名称中。 -->
                    <Button x:Name="ThemeToggleButton" Width="38" Padding="8,5" Margin="0,0,10,0"
                            ToolTip="{loc:Text Source='切换到日间模式'}" AutomationProperties.Name="{loc:Text Source='切换到日间模式'}"
                            Click="ThemeToggleButton_Click" Style="{StaticResource HeaderIconButton}">
                        <Grid Width="20" Height="22">
                            <Path x:Name="BulbGlass" Data="M 6,14 C 6,11 3,11 3,7 A 7,7 0 0 1 17,7 C 17,11 14,11 14,14 Z"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.3" Fill="Transparent"/>
                            <Path Data="M 7,17 L 13,17 M 8,20 L 12,20" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.3"/>
                            <Path x:Name="BulbRays" Data="M 7,7 L 9,10 L 11,7 M 9,10 L 9,14"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="QqGroupButton" Width="38" Padding="8,5" Margin="0,0,10,0"
                            ToolTip="{loc:Text Source='加入官方 QQ 群'}" AutomationProperties.Name="{loc:Text Source='加入官方 QQ 群'}"
                            Click="QqGroupButton_Click" Style="{StaticResource HeaderIconButton}">
                        <!-- Remix Icon v4.6.0 qq-line：保留原始路径与非零填充规则，随主题调整颜色。 -->
