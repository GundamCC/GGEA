<Window x:Class="GGEA.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:GGEA.App.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:GGEA.App.UI"
        Title="GGEA — SD Gundam G Generation ETERNAL Assistant"
        Width="1280" Height="820"
        MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{loc:UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="28,10,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 档案终端页眉：品牌、用途与细线构成层级，装饰不参与命中测试。 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GGEA" FontFamily="Segoe UI" FontSize="32" FontWeight="Bold" LineHeight="36"/>
                    <TextBlock Text="SD Gundam G Generation ETERNAL Assistant" FontSize="11" FontWeight="SemiBold" Margin="1,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 灯泡显示当前明暗状态；操作说明保留在提示与辅助功能名称中。 -->
                    <Button x:Name="ThemeToggleButton" Width="38" Padding="8,5" Margin="0,0,10,0"
                            ToolTip="{loc:Text Source='切换到日间模式'}" AutomationProperties.Name="{loc:Text Source='切换到日间模式'}"
                            Click="ThemeToggleButton_Click" Style="{StaticResource HeaderIconButton}">
                        <Viewbox Width="17" Height="18.7">
                        <Grid Width="20" Height="22">
                            <Path x:Name="BulbGlass" Data="M 6,14 C 6,11 3,11 3,7 A 7,7 0 0 1 17,7 C 17,11 14,11 14,14 Z"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.3" Fill="Transparent"/>
                            <Path Data="M 7,17 L 13,17 M 8,20 L 12,20" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.3"/>
                            <Path x:Name="BulbRays" Data="M 7,7 L 9,10 L 11,7 M 9,10 L 9,14"
                                  Stroke="{DynamicResource Brush.Text}" StrokeThickness="1" Visibility="Collapsed"/>
                        </Grid>
                        </Viewbox>
                    </Button>
                    <Button x:Name="QqGroupButton" Width="38" Padding="8,5" Margin="0,0,10,0"
                            ToolTip="{loc:Text Source='加入官方 QQ 群'}" AutomationProperties.Name="{loc:Text Source='加入官方 QQ 群'}"
                            Click="QqGroupButton_Click" Style="{StaticResource HeaderIconButton}">
                        <!-- Remix Icon v4.6.0 qq-line：保留原始路径与非零填充规则，随主题调整颜色。 -->
                        <Viewbox Width="20" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource Brush.Text}" Data="F1 M17.5359 12.5144L16.8402 10.7175C16.8408 10.6968 16.8494 10.3429 16.8494 10.1604C16.8494 7.08792 15.448 4.0003 12.0012 4C8.55459 4.0003 7.15292 7.08792 7.15292 10.1604C7.15292 10.3429 7.16151 10.6968 7.16209 10.7175L6.4667 12.5144C6.27608 13.0285 6.08776 13.564 5.94988 14.0232C5.29262 16.2126 5.50559 17.1186 5.66783 17.139C6.01581 17.1823 7.02221 15.4908 7.02221 15.4908C7.02221 16.4704 7.5095 17.7487 8.56405 18.6719C8.16963 18.7976 7.68635 18.9911 7.37564 19.2284C7.09645 19.442 7.13142 19.6594 7.18158 19.7473C7.40258 20.1329 10.9713 19.9935 12.0017 19.8733C13.0319 19.9935 16.6009 20.1329 16.8216 19.7473C16.872 19.6594 16.9067 19.442 16.6275 19.2284C16.3168 18.9911 15.8333 18.7976 15.4386 18.6716C16.4928 17.7487 16.9801 16.4704 16.9801 15.4908C16.9801 15.4908 17.9868 17.1823 18.3348 17.139C18.4967 17.1186 18.7131 16.2108 18.0524 14.0232C17.9125 13.56 17.7265 13.0285 17.5359 12.5144ZM18.5574 20.7407C18.1843 21.3926 17.7237 21.6334 17.1187 21.7981C16.8792 21.8633 16.621 21.9056 16.325 21.936C15.8844 21.9814 15.3392 22.001 14.712 22C13.786 21.9985 12.693 21.9491 12.0017 21.884C11.3103 21.9491 10.2173 21.9985 9.29129 22C8.66414 22.001 8.11889 21.9814 7.67832 21.936C7.38236 21.9056 7.12409 21.8633 6.88467 21.7981C6.27994 21.6335 5.81954 21.393 5.44496 20.7393C5.15165 20.2258 5.07747 19.6406 5.20612 19.0866C4.61376 18.9546 4.20483 18.6045 3.92733 18.1757C3.77911 17.9466 3.68408 17.7127 3.61845 17.4663C3.53001 17.1344 3.49486 16.7666 3.50184 16.3601C3.51532 15.5749 3.68902 14.5984 4.03435 13.4481C4.17427 12.9821 4.3614 12.4396 4.6015 11.7926L5.15467 10.3632C5.1536 10.287 5.15292 10.2154 5.15292 10.1604C5.15292 5.6047 7.58875 2.00038 12.0013 2C16.4138 2.00038 18.8494 5.60454 18.8494 10.1604C18.8494 10.2154 18.8487 10.2869 18.8477 10.3631L19.401 11.7923L19.4112 11.8191C19.636 12.4254 19.8242 12.9722 19.967 13.445C20.3145 14.5956 20.4889 15.5735 20.5018 16.361C20.5085 16.768 20.4728 17.1365 20.3837 17.4689C20.3178 17.7148 20.2226 17.9483 20.0746 18.1768C19.7976 18.6041 19.3905 18.9532 18.7974 19.0862C18.9266 19.6411 18.8523 20.2274 18.5574 20.7407Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="WebsiteButton" Width="38" Padding="8,5" Margin="0,0,10,0"
                            ToolTip="{loc:Text Source='官方网站'}" AutomationProperties.Name="{loc:Text Source='官方网站'}"
                            Click="WebsiteButton_Click" Style="{StaticResource HeaderIconButton}">
                        <!-- Remix Icon v4.6.0 earth-line：保留原始路径与非零填充规则，随主题调整颜色。 -->
                        <Viewbox Width="20" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource Brush.Text}" Data="F1 M6.23509 6.45329C4.85101 7.89148 4 9.84636 4 12C4 16.4183 7.58172 20 12 20C13.0808 20 14.1116 19.7857 15.0521 19.3972C15.1671 18.6467 14.9148 17.9266 14.8116 17.6746C14.582 17.115 13.8241 16.1582 12.5589 14.8308C12.2212 14.4758 12.2429 14.2035 12.3636 13.3943L12.3775 13.3029C12.4595 12.7486 12.5971 12.4209 14.4622 12.1248C15.4097 11.9746 15.6589 12.3533 16.0043 12.8777C16.0425 12.9358 16.0807 12.9928 16.1198 13.0499C16.4479 13.5297 16.691 13.6394 17.0582 13.8064C17.2227 13.881 17.428 13.9751 17.7031 14.1314C18.3551 14.504 18.3551 14.9247 18.3551 15.8472V15.9518C18.3551 16.3434 18.3168 16.6872 18.2566 16.9859C19.3478 15.6185 20 13.8854 20 12C20 8.70089 18.003 5.8682 15.1519 4.64482C14.5987 5.01813 13.8398 5.54726 13.575 5.91C13.4396 6.09538 13.2482 7.04166 12.6257 7.11976C12.4626 7.14023 12.2438 7.12589 12.012 7.11097C11.3905 7.07058 10.5402 7.01606 10.268 7.75495C10.0952 8.2232 10.0648 9.49445 10.6239 10.1543C10.7134 10.2597 10.7307 10.4547 10.6699 10.6735C10.59 10.9608 10.4286 11.1356 10.3783 11.1717C10.2819 11.1163 10.0896 10.8931 9.95938 10.7412C9.64554 10.3765 9.25405 9.92233 8.74797 9.78176C8.56395 9.73083 8.36166 9.68867 8.16548 9.64736C7.6164 9.53227 6.99443 9.40134 6.84992 9.09302C6.74442 8.8672 6.74488 8.55621 6.74529 8.22764C6.74529 7.8112 6.74529 7.34029 6.54129 6.88256C6.46246 6.70541 6.35689 6.56446 6.23509 6.45329ZM12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="DocumentationButton" Width="38" Padding="8,5" Margin="0,0,10,0"
                            ToolTip="{loc:Text Source='使用文档'}" AutomationProperties.Name="{loc:Text Source='使用文档'}"
                            Click="DocumentationButton_Click" Style="{StaticResource HeaderIconButton}">
                        <!-- Remix Icon v4.6.0 book-open-line：保留原始路径与非零填充规则，随主题调整颜色。 -->
                        <Viewbox Width="20" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource Brush.Text}" Data="F1 M13 21V23H11V21H3C2.44772 21 2 20.5523 2 20V4C2 3.44772 2.44772 3 3 3H9C10.1947 3 11.2671 3.52375 12 4.35418C12.7329 3.52375 13.8053 3 15 3H21C21.5523 3 22 3.44772 22 4V20C22 20.5523 21.5523 21 21 21H13ZM20 19V5H15C13.8954 5 13 5.89543 13 7V19H20ZM11 19V7C11 5.89543 10.1046 5 9 5H4V19H11Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Grid>
                        <Button x:Name="SettingsButton" Width="38" Padding="8,5" Click="SettingsButton_Click"
                                ToolTip="{loc:Text Source='设置'}" Style="{StaticResource HeaderIconButton}" AutomationProperties.Name="{loc:Text Source='设置'}">
                            <!-- Remix Icon v4.6.0 settings-3-line；外层 Grid 保留更新圆点的独立定位。 -->
                            <Viewbox Width="20" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource Brush.Text}" Data="{StaticResource SettingsIconGeometry}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- 标记不拦截点击；辅助功能名称同时提供新版提示，不只依赖颜色。 -->
                        <Border x:Name="UpdateBadge" Width="9" Height="9" CornerRadius="5"
                                Background="#F06449" BorderBrush="{DynamicResource Brush.Background}" BorderThickness="1"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧栏 -->
            <!-- 设备与执行按钮固定，只有任务清单滚动，缩小窗口也可立即开始或停止。 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 模拟器卡片 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Source='设备连接'}" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DeviceCombo"
                                      Grid.Column="0"
                                      Style="{StaticResource ComboBoxDark}"
                                      VerticalContentAlignment="Center"
                                      ToolTip="{Binding SelectedItem.Display, RelativeSource={RelativeSource Self}}"
                                      SelectionChanged="DeviceCombo_SelectionChanged"/>
                            <Button x:Name="RefreshButton"
                                    Grid.Column="2"
                                    Content="{loc:Text Source='刷新'}"
                                    Click="RefreshButton_Click"
                                    Style="{StaticResource ButtonSecondary}"/>
                        </Grid>
                        <!-- 状态并列呈现，为任务清单保留更多高度；状态保持单行，完整信息可悬停查看。 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DeviceStatusText" Style="{StaticResource StatusText}" Text="{loc:Text Source='未检测设备'}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionStateText" Grid.Column="1" Style="{StaticResource StatusText}" Text="{loc:Text Source='未连接'}" Margin="0" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <!-- 重连与启动分行于设备选择，保留地址的可读宽度。 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        <Button x:Name="StartGameButton" Content="{loc:Text Source='启动模拟器 / 打开游戏'}"
                                Click="StartGameButton_Click"
                                Style="{StaticResource ButtonPrimary}"/>
                        <Button x:Name="ReconnectButton" Grid.Column="1" Content="{loc:Text Source='重连'}" Margin="8,0,0,0"
                                IsEnabled="False" Click="ReconnectButton_Click"
                                ToolTip="{loc:Text Source='先选择离线 IP 设备，再重连该地址；不会启动游戏或重启共享 ADB 服务'}"
                                Style="{StaticResource ButtonSecondary}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 每日任务卡片 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <ui:DailyTaskListView x:Name="DailyView"/>
                </Border>

                <!-- 账号状态卡片 -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Source='账号状态'}" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="AccountStatusText"
                                   Text="{loc:Text Source='等待连接设备'}"
                                   Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右侧主区域 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="148"/>
                </Grid.RowDefinitions>

                <!-- 截图 / 操作卡片 -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TabControl x:Name="MainTabControl" Background="Transparent" BorderThickness="0">
                            <TabItem x:Name="ApConsumptionTab" Header="{loc:Text Source='AP 消耗'}">
                                <ui:ApConsumptionView x:Name="ApConsumptionView"/>
                            </TabItem>
                            <!-- 位置：开发版作品画布坐标调试工具，发布版不显示。 -->
                            <TabItem x:Name="StagePositionTab" Header="{loc:Text Source='位置'}" Visibility="Collapsed">
                                <ui:StagePositionView x:Name="StagePositionView"/>
                            </TabItem>

                            <!-- 奖励：配置“领取奖励”要执行的子任务。 -->
                            <TabItem x:Name="RewardTab" Header="{loc:Text Source='奖励'}">
                                <ui:RewardView x:Name="RewardView"/>
                            </TabItem>
                            <!-- 自动刷本 -->
                            <TabItem x:Name="AutoFarmTab" Header="{loc:Text Source='自动刷本'}">
                                <ui:AutoFarmView x:Name="AutoFarmView"/>
                            </TabItem>
                            <!-- 招募入口与自动刷本相邻，沿用现有主题与状态反馈。 -->
                            <TabItem x:Name="AutoScoutTab" Header="{loc:Text Source='自动招募'}">
                                <ui:ScoutView x:Name="ScoutView"/>
                            </TabItem>
                            <!-- 推图队列、编制权限与当前状态共用执行会话，运行中禁止改写队列和策略。 -->
                            <TabItem x:Name="AutoProgressTab" Header="{loc:Text Source='自动推图'}">
                                <ui:AutoProgressView x:Name="AutoProgressView"/>
                            </TabItem>
                            <!-- 活动导航止于左侧入口选择，后续玩法由独立流程接入。 -->
                            <TabItem x:Name="FierceEnemyAssaultTab" Header="{loc:Text Source='强敌来袭'}">
                                <ui:FierceEnemyAssaultView x:Name="FierceEnemyAssaultView"/>
                            </TabItem>
                            <TabItem x:Name="LimitedEventTab" Header="{loc:Text Source='限时活动'}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Text Source='请在非战斗界面使用。'}" Style="{StaticResource HintText}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Text Source='当前活动'}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="LimitedActivity" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource ComboBoxDark}" DisplayMemberPath="Work"/>
                                        <TextBlock Grid.Column="2" Text="{loc:Text Source='略过BOSS难度'}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="16,0,10,0"/>
                                        <ComboBox x:Name="LimitedDifficulty" Grid.Column="3" Style="{StaticResource ComboBoxDark}" Width="130" SelectedIndex="0">
                                            <ComboBoxItem Content="EXPERT"/><ComboBoxItem Content="HARD"/><ComboBoxItem Content="NORMAL"/>
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Text="{loc:Text Source='立即执行'}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <UniformGrid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Columns="4" Rows="1" Margin="-3,0,-3,0">
                                            <Button x:Name="EventProgress" Content="{loc:Text Source='事件关卡推图'}" Click="QueueEventProgress_Click" Style="{StaticResource ButtonSecondary}" Margin="3,0" Padding="5,0"/>
                                            <Button x:Name="EventDaily" Content="{loc:Text Source='每日10次关卡'}" Click="LimitedStart_Click" Style="{StaticResource ButtonSecondary}" Margin="3,0" Padding="5,0"/>
                                            <Button x:Name="LimitedStart" Content="{loc:Text Source='BOSS 略过'}" Click="LimitedStart_Click" Style="{StaticResource ButtonSecondary}" Margin="3,0" Padding="5,0"/>
                                            <Button x:Name="MedalStart" Content="{loc:Text Source='奖章自动兑换'}" Click="LimitedStart_Click" Style="{StaticResource ButtonSecondary}" Margin="3,0" Padding="5,0"/>
                                        </UniformGrid>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                        <Grid x:Name="EventDailyOptions" Margin="0,0,6,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.RowSpan="2" Text="{loc:Text Source='每日任务'}" Foreground="{DynamicResource Brush.Text}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <CheckBox Style="{StaticResource TaskCheckBox}" HorizontalContentAlignment="Left" Foreground="{DynamicResource Brush.Text}" x:Name="IncludeStages" Content="{loc:Text Source='每日10次关卡'}" IsChecked="True" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" Margin="0,6,40,6"/>
                                            <CheckBox Style="{StaticResource TaskCheckBox}" HorizontalContentAlignment="Left" Foreground="{DynamicResource Brush.Text}" x:Name="IncludeBoss" Content="{loc:Text Source='BOSS 战斗'}" IsChecked="True" VerticalAlignment="Center" Grid.Row="0" Grid.Column="2" Margin="0,6,12,6"/>
                                            <CheckBox Style="{StaticResource TaskCheckBox}" HorizontalContentAlignment="Left" Foreground="{DynamicResource Brush.Text}" x:Name="IncludeMedals" Content="{loc:Text Source='奖章机体补给'}" IsChecked="True" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="0,6,40,6"/>
                                            <CheckBox Style="{StaticResource TaskCheckBox}" HorizontalContentAlignment="Left" Foreground="{DynamicResource Brush.Text}" x:Name="IncludeMissionRewards" Content="{loc:Text Source='领取限时活动使命奖励'}" IsChecked="True" VerticalAlignment="Center" Grid.Row="1" Grid.Column="2" Margin="0,6,12,6"/>
                                            <Button x:Name="AddLimitedDaily" Content="{loc:Text Source='添加到每日任务'}" Click="AddLimitedDaily_Click" Style="{StaticResource ButtonPrimary}" Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="LimitedStatus" Style="{StaticResource StatusText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem x:Name="MasterLeagueTab" Header="{loc:Text Source='大师联盟'}">
                                <ui:MasterLeagueView x:Name="MasterLeagueView"/>
                            </TabItem>
                            <!-- 铁球工厂入口。 -->
                            <TabItem x:Name="BallFactoryTab" Header="{loc:Text Source='铁球工厂'}">
                                <ui:BallFactoryView x:Name="BallFactoryView"/>
                            </TabItem>
                            <!-- 截图 / 操作：开发版显示，发布版不显示。 -->
                            <TabItem x:Name="ScreenshotTab" Header="{loc:Text Source='截图与操作'}" Visibility="Collapsed">
                                <ui:ScreenshotView x:Name="ScreenshotView"/>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>

                <!-- 日志卡片 -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Text Source='日志'}" Style="{StaticResource CardTitle}"/>
                        <ListBox x:Name="LogList"
                                 Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource LogList}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部状态与版权信息：状态靠左，版权归属固定靠右。 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                       HorizontalAlignment="Left"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextDim}"/>
            <TextBlock x:Name="CopyrightText" Grid.Column="1"
                       HorizontalAlignment="Right"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.TextDim}"/>
        </Grid>
    </Grid>
</Window>
