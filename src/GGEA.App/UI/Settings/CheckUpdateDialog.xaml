<Window x:Class="GGEA.App.UI.CheckUpdateDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:GGEA.App.Localization"
 Title="{loc:Text Source='检查更新'}" Width="410" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Brush.Background}"
 Foreground="{DynamicResource Brush.Text}" FontFamily="{loc:UiFont}">
 <StackPanel Margin="28,24">
  <TextBlock x:Name="Status" Text="{loc:Text Source='正在检查更新…'}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
   <TextBlock x:Name="Details" Style="{StaticResource HintText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </ScrollViewer>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
   <Button x:Name="Dismiss" IsCancel="True" Content="{loc:Text Source='取消'}" Style="{StaticResource ButtonSecondary}" Margin="0,0,8,0"/>
   <Button x:Name="ActionButton" IsDefault="True" Visibility="Collapsed" Style="{StaticResource ButtonPrimary}" Click="Act"/>
  </StackPanel>
 </StackPanel>
</Window>
